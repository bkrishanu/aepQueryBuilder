# Copy to backend/.env for local development (never commit the real .env).
# Key used to encrypt the credential session cookie — 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production (set it as a Vercel environment variable). Changing it
# signs everyone out.
SESSION_SECRET=

# Port used when a connection gives none (the UI reads it from GET /api/config).
# Query Service listens on 80; use 5432 for a plain Postgres server.
# PG_DEFAULT_PORT=80

# Query result limits. Rows are read through a cursor QUERY_CURSOR_BATCH_SIZE at
# a time and streamed to the browser; each result set stops at QUERY_MAX_ROWS.
# The results grid shows QUERY_PAGE_SIZE rows per page.
# QUERY_MAX_ROWS=10000
# QUERY_PAGE_SIZE=100
# QUERY_CURSOR_BATCH_SIZE=500
# Set to false to run statements without a cursor (simple query protocol).
# QUERY_USE_CURSOR=true
